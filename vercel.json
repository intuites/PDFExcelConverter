{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/convert.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/convert", "destination": "/api/convert" },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/app.js", "destination": "/web/app.js" },
    { "source": "/style.css", "destination": "/web/style.css" }
  ]
}
