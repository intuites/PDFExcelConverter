{
  "version": 2,
  "builds": [
    { "src": "api/convert.py", "use": "@vercel/python" },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/convert", "dest": "api/convert.py" },
    { "src": "/convert", "dest": "api/convert.py" },
    { "src": "/", "dest": "web/index.html" },
    { "src": "/(.*)", "dest": "web/$1" }
  ]
}
